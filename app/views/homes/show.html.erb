<% content_for :title, "Home · Stube" %>
<%= turbo_stream_from Current.household, :home %>

<%= render "shared/header", title: "Home" %>

<div class="min-h-0 flex-1 overflow-y-auto bg-stone-50 p-4 md:p-6 dark:bg-stone-950">
  <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
    <article class="rounded-2xl border border-stone-200 bg-white dark:border-stone-800 dark:bg-stone-900">
      <%= render "homes/shopping_card", household: Current.household %>
      <div class="hidden p-4 pt-2 md:block">
        <%= render "shopping_items/add_form" %>
      </div>
    </article>
  </div>
</div>
