<%# locals: (message:, event: nil) %>
<div data-controller="dismiss" role="status"
     class="pointer-events-auto flex max-w-full items-center gap-4 rounded-xl bg-stone-900 py-2 pr-2 pl-4 text-sm text-white shadow-lg dark:bg-stone-100 dark:text-stone-900">
  <span class="min-w-0 truncate py-2"><%= message %></span>
  <% if event %>
    <%= button_to "Undo", shopping_event_put_back_path(event), form: { class: "shrink-0" },
          class: "h-9 cursor-pointer rounded-lg px-3 font-semibold text-accent-400 hover:bg-white/10 dark:text-accent-700 dark:hover:bg-stone-900/10" %>
  <% end %>
</div>
