<% back = @invite.device_link? ? member_path(@invite.member) : household_path %>
<% for_whom = @invite.member == Current.member ? "you" : @invite.member&.name %>
<% content_for :title, "Invite · Stube" %>

<%# A modal: a native sheet in the app later, a page with a close button on the web. %>
<div class="min-h-0 flex-1 overflow-y-auto bg-stone-50 dark:bg-stone-950">
  <div class="mx-auto max-w-md bg-white p-6 md:mt-10 md:rounded-2xl md:border md:border-stone-200 md:shadow-sm dark:bg-stone-900 md:dark:border-stone-800">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h1 class="text-xl font-semibold"><%= @invite.device_link? ? "Add a device for #{for_whom}" : "Invite someone" %></h1>
        <p class="mt-1 muted">
          <%= @invite.device_link? ? "Scan this on the new device. It works once." : "Scan this to join #{Current.household.name}." %>
        </p>
      </div>
      <%= link_to back, class: "-mt-1 -mr-2 flex size-11 shrink-0 items-center justify-center rounded-full text-stone-500 hover:bg-stone-100 dark:hover:bg-stone-800", "aria-label": "Close" do %>
        <%= icon :close %>
      <% end %>
    </div>

    <% if @code %>
      <% url = join_url(code: @code) %>
      <div class="mt-6 flex justify-center"><%= qr_code(url) %></div>

      <div class="mt-6 flex items-center gap-2 rounded-lg bg-stone-100 p-1 pl-3 dark:bg-stone-800" data-controller="clipboard">
        <input type="text" readonly value="<%= url %>" aria-label="Invite link" data-clipboard-target="source"
               class="min-w-0 flex-1 truncate bg-transparent font-mono text-sm outline-none" data-action="focus->clipboard#select">
        <button type="button" hidden data-clipboard-target="button" data-action="clipboard#copy"
                class="h-9 rounded-md bg-white px-3 text-sm font-medium shadow-sm dark:bg-stone-700">Copy</button>
      </div>

      <p class="mt-4 muted">
        <% if @invite.device_link? %>
          Valid until <%= l @invite.expires_at, format: "%H:%M" %>.
        <% else %>
          Anyone with this invite can join until <%= l @invite.expires_at, format: "%a %H:%M" %>.
        <% end %>
      </p>
    <% else %>
      <p class="mt-6 text-sm text-stone-600 dark:text-stone-400">
        The code is only shown once, right after the invite is made. Make a new one to show it again.
      </p>
    <% end %>

    <div class="mt-6 flex gap-3">
      <%= link_to "Done", back, class: "button flex-1" %>
      <%= button_to "Revoke", invite_path(@invite), method: :delete,
            class: "inline-flex h-11 cursor-pointer items-center justify-center rounded-lg px-4 font-medium text-red-600 hover:bg-red-50 dark:text-red-400 dark:hover:bg-red-950" %>
    </div>
  </div>
</div>
