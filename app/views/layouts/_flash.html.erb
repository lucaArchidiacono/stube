<%# locals: (inline: false) %>
<% { notice: "bg-accent-50 text-accent-900 dark:bg-accent-950 dark:text-accent-100",
     alert: "bg-amber-100 text-amber-900 dark:bg-amber-900/60 dark:text-amber-100" }.each do |type, colors| %>
  <% if flash[type].present? %>
    <div role="status" class="<%= colors %> <%= inline ? "mb-5 rounded-lg px-3 py-2" : "shrink-0 px-4 py-2 text-center" %> text-sm font-medium"><%= flash[type] %></div>
  <% end %>
<% end %>
