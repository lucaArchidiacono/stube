<%# One centered card on every width: first setup and joining. %>
<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <%= render "layouts/head" %>
  </head>

  <body class="min-h-full bg-stone-50 text-stone-900 antialiased dark:bg-stone-950 dark:text-stone-100">
    <main class="flex min-h-dvh items-center justify-center px-4 py-10">
      <div class="w-full max-w-md rounded-2xl border border-stone-200 bg-white p-6 shadow-sm sm:p-8 dark:border-stone-800 dark:bg-stone-900">
        <%= render "layouts/flash", inline: true %>
        <%= yield %>
      </div>
    </main>
  </body>
</html>
