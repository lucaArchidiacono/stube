<% household = @invite&.household || Household.first %>
<% content_for :title, "Join #{household.name} · Stube" %>

<% if Current.device %>
  <h1 class="text-2xl font-semibold">You're already in <%= Current.household.name %></h1>
  <%= link_to "Open Stube", root_path, class: "button mt-6 w-full" %>

<% elsif @invite&.device_link? %>
  <p class="text-stone-600 dark:text-stone-400"><%= household.name %></p>
  <h1 class="text-2xl font-semibold">Add this device for <%= @invite.member.name %>?</h1>
  <p class="mt-2 text-stone-600 dark:text-stone-400">It becomes one of <%= @invite.member.name %>'s personal devices.</p>
  <%= button_to "Add", join_path(code: params[:code]), class: "button mt-6 w-full" %>

<% elsif @invite %>
  <p class="text-stone-600 dark:text-stone-400"><%= @invite.created_by.name %> invited you to</p>
  <h1 class="text-2xl font-semibold"><%= household.name %></h1>

  <%= form_with url: join_path(code: params[:code]), class: "group mt-6 space-y-5" do |form| %>
    <fieldset>
      <legend class="text-sm font-medium">Whose device is this?</legend>
      <div class="mt-2 grid grid-cols-2 gap-1 rounded-xl bg-stone-100 p-1 dark:bg-stone-800">
        <% { "mine" => "Mine", "shared" => "Shared" }.each do |value, label| %>
          <label class="flex h-11 cursor-pointer items-center justify-center rounded-lg text-stone-600 has-[:checked]:bg-white has-[:checked]:font-medium has-[:checked]:text-stone-900 has-[:checked]:shadow-sm dark:text-stone-300 dark:has-[:checked]:bg-stone-950 dark:has-[:checked]:text-white">
            <%= radio_button_tag :kind, value, (params[:kind] || "mine") == value, id: "kind-#{value}", class: "sr-only" %> <%= label %>
          </label>
        <% end %>
      </div>
      <p class="mt-2 muted group-has-[#kind-shared:checked]:hidden">Only you use it. Your changes show your name.</p>
      <p class="mt-2 hidden muted group-has-[#kind-shared:checked]:block">The whole household uses it, like a kitchen iPad. It can't invite or remove anyone.</p>
    </fieldset>

    <label class="block group-has-[#kind-shared:checked]:hidden">
      <span class="text-sm font-medium">Your name</span>
      <%= text_field_tag :name, params[:name], maxlength: 50, autocomplete: "given-name", class: "input mt-1" %>
    </label>
    <label class="hidden group-has-[#kind-shared:checked]:block">
      <span class="text-sm font-medium">Device name</span>
      <%= text_field_tag :device_name, params[:device_name], maxlength: 50, placeholder: "Kitchen iPad", class: "input mt-1" %>
    </label>

    <%= form.button "Join", class: "button w-full" %>
  <% end %>

  <p class="mt-5 muted">
    Already in <%= household.name %>? Don't join again, that makes a new person.
    On a device you already use, open your profile and tap “Add a device”.
  </p>

<% elsif params[:code].present? %>
  <h1 class="text-2xl font-semibold">This invite has expired</h1>
  <p class="mt-2 text-stone-600 dark:text-stone-400">Ask someone in the household for a new one.</p>

<% else %>
  <h1 class="text-2xl font-semibold"><%= household.name %></h1>
  <p class="mt-2 text-stone-600 dark:text-stone-400">To join, scan an invite from someone in the household.</p>
<% end %>
