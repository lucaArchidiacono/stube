<%# locals: (title:, back: nil, trailing: nil) %>
<header class="flex h-14 shrink-0 items-center gap-2 border-b border-stone-200 px-4 dark:border-stone-800">
  <% if back %>
    <%= link_to back.last, class: "-ml-2 flex h-11 items-center gap-0.5 pr-2 text-accent-600 dark:text-accent-400" do %>
      <%= icon :chevron_left, "size-5" %><span><%= back.first %></span>
    <% end %>
  <% end %>
  <h1 class="truncate text-lg font-semibold"><%= title %></h1>
  <div class="ml-auto flex items-center gap-2"><%= trailing %></div>
</header>
